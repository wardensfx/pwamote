{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PwaMote",
  "version": "0.1.0",
  "identifier": "app.pwamote.desktop",
  "build": {
    "frontendDist": "../../desktop-ui/dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "PwaMote",
        "width": 480,
        "height": 800,
        "minWidth": 420,
        "minHeight": 620,
        "center": true,
        "visible": false,
        "transparent": true,
        "dragDropEnabled": false,
        "decorations": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.png", "icons/icon.ico"],
    "publisher": "PwaMote",
    "shortDescription": "Votre téléphone, télécommande de votre PC.",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["French"],
        "displayLanguageSelector": false
      }
    }
  }
}
